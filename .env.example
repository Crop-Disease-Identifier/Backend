# Database configuration
# For local PostgreSQL (no SSL):
# database_url=postgresql://username:password@localhost:5432/crop_identifier

# For remote PostgreSQL (Neon, AWS RDS, Railway with SSL):
# database_url=postgresql://username:password@host:5432/database_name

# Optional: Override SSL mode (auto-detected by default)
# DB_SSL_MODE=require  # or disable

# JWT Configuration
SECRET=your-secret-key-here-change-this-in-production
ALGORITHM=HS256

# Email Configuration (if using Resend)
# RESEND_API_KEY=your-resend-api-key
